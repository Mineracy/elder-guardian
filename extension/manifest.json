{
  "manifest_version": 3,
  "name": "Elder Guardian",
  "version": "2.0.0",
  "icons": {
    "128": "guardian-icon.png"
  },
  "description": "Pauses risky links and asks a trusted contact to approve them, to protect against scams.",
  "permissions": [
    "storage",
    "downloads",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://guardian-backend.rowdyhacks.workers.dev/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/transactions.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
