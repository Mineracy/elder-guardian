{
  "manifest_version": 3,
  "name": "Guardian",
  "version": "2.0.0",
  "description": "Pauses risky links and asks a trusted contact to approve them, to protect against scams.",
  "permissions": ["storage", "downloads", "webNavigation", "tabs"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
