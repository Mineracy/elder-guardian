{
  "name": "app",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply guardian --local",
    "db:migrate:remote": "wrangler d1 migrations apply guardian --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "wrangler": "^4.110.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.0"
  }
}
