{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardian-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  // The React site is served by this same Worker; API/review/verify paths go to Hono first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/review/*", "/verify/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardian",
      // Replace with the id from `wrangler d1 create guardian` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // No "vars" here on purpose: secrets and per-environment settings come from `.dev.vars` locally
  // (see .dev.vars.example) and from `wrangler secret put` / the dashboard in production.
}
