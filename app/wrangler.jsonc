{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardian-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "dev": { "port": 3000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardian",
      // Replace with the id from `wrangler d1 create guardian` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public URL used in review links emailed to trusted contacts.
    "APP_BASE_URL": "http://localhost:3000",
    // Origin of the React website (see ../web).
    "WEB_URL": "http://localhost:5173",
    "ENVIRONMENT": "dev"
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally):
  //   GEMINI_API_KEY, RESEND_API_KEY, EMAIL_FROM
}
